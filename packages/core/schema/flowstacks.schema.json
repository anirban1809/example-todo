{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "flowstacks.ai project configuration",
  "type": "object",
  "required": ["tenantId", "projectId", "name", "environments", "framework", "rateLimitPolicies"],
  "properties": {
    "tenantId": { "$ref": "#/$defs/id" },
    "projectId": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "repository": { "type": ["string", "null"], "format": "uri" },
    "environments": { "type": "array", "minItems": 1, "items": { "enum": ["development", "staging", "production"] } },
    "featureEnvironments": { "type": "boolean", "default": false },
    "framework": { "enum": ["react-vite", "nextjs"] },
    "defaultRoutePolicy": { "$ref": "#/$defs/routePolicy" },
    "routes": { "type": "object", "propertyNames": { "pattern": "^(GET|POST|PUT|PATCH|DELETE|HEAD|OPTIONS) /api(?:/[^\\s?#{}]+)*$" }, "additionalProperties": { "$ref": "#/$defs/routePolicy" } },
    "rateLimitPolicies": { "type": "object", "additionalProperties": { "$ref": "#/$defs/rateLimitPolicy" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,30}$" },
    "routePolicy": { "type": "object", "required": ["auth", "rateLimitPolicy"], "properties": { "auth": { "enum": ["cognito", "public"] }, "rateLimitPolicy": { "$ref": "#/$defs/id" } }, "additionalProperties": false },
    "rateRule": { "type": "object", "required": ["scope", "requests", "windowSeconds"], "properties": { "scope": { "enum": ["ip", "user", "tenant", "global"] }, "requests": { "type": "integer", "minimum": 1 }, "windowSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 } }, "additionalProperties": false },
    "quota": { "type": "object", "required": ["scope", "requests", "period"], "properties": { "scope": { "enum": ["ip", "user", "tenant", "global"] }, "requests": { "type": "integer", "minimum": 1 }, "period": { "enum": ["hour", "day", "month", "lifetime"] } }, "additionalProperties": false },
    "tierLimit": { "type": "object", "required": ["rate", "concurrency"], "properties": { "rate": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/rateRule" } }, "quota": { "$ref": "#/$defs/quota" }, "concurrency": { "type": "integer", "minimum": 1, "maximum": 1000 } }, "additionalProperties": false },
    "rateLimitPolicy": { "type": "object", "required": ["tiers"], "properties": { "anonymous": { "$ref": "#/$defs/tierLimit" }, "tiers": { "type": "object", "required": ["free"], "additionalProperties": { "$ref": "#/$defs/tierLimit" } } }, "additionalProperties": false }
  },
  "additionalProperties": false
}
