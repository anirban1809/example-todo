{
  "name": "flowstacks-next-app-example-todo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "infra",
    "packages/*"
  ],
  "scripts": {
    "dev": "cross-env FLOWSTACKS_LOCAL=true next dev -p 5174",
    "build:web": "node scripts/build-web.mjs",
    "build": "npm run build -w @flowstacks/core && npm run build:web",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present",
    "test": "vitest run --passWithNoTests --exclude 'dist/**'",
    "synth": "npm run build && cd infra && npx cdk synth",
    "deploy": "npm run build && cd infra && npx cdk deploy --require-approval never"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1133.0",
    "@aws-sdk/lib-dynamodb": "^3.1133.0",
    "@flowstacks/core": "*",
    "amazon-cognito-identity-js": "^6.3.15",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/aws-lambda": "^8.10.163",
    "@types/node": "^24.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "aws-cdk": "^2.1141.0",
    "aws-cdk-lib": "^2.269.0",
    "constructs": "^10.4.2",
    "cross-env": "^10.0.0",
    "esbuild": "^0.25.9",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vitest": "^5.0.1"
  }
}
